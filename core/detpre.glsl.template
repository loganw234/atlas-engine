/* Pinned helpers the ENGINE owns, built on detlib.
   Kept in a separate file on purpose: detlib.glsl must stay
   byte-identical to the library the darkroom already runs and whose
   cross-vendor hashes are the pinned reference, so nothing new is ever
   added to it. This is where new pinned forms go instead.

   Each of these replaces a GLSL builtin the emitter used to write
   directly. They are NOT drop-in equivalents - a pinned form computes a
   different (and deterministic) value from the builtin it replaces, and
   that is the whole trade. What they share with the builtin is the
   mathematical definition; what they add is a fixed association and a
   fixed rounding at every step.

   `precise` on every intermediate, and that is not decoration. Measured
   2026-08-22 on five stacks: whether a compiler folds `a*b + c` into an
   fma depends on whether `a*b` is needed ELSEWHERE in the same shader -
   radeonsi and iris contract it until a second consumer of the product
   appears, at which point common subexpression elimination shares the
   product and the fusion is gone. So an unqualified expression's
   rounding is a function of code that is not near it. `precise` is the
   only thing in the sweep that behaved identically in every
   configuration on every stack. */

/* length(), which is sqrt(dot(v,v)) - and dot() is a sum of products
   whose order and contraction the compiler chooses. Named squares,
   named sum, det_sqrt on top. */
float det_len2(float x, float y){
  precise float xx = x * x;
  precise float yy = y * y;
  precise float s = xx + yy;
  return det_sqrt(s);
}

/* Three terms need their association stated as well as their rounding:
   (xx + yy) + zz, never xx + (yy + zz). */
float det_len3(float x, float y, float z){
  precise float xx = x * x;
  precise float yy = y * y;
  precise float zz = z * z;
  precise float a = xx + yy;
  precise float s = a + zz;
  return det_sqrt(s);
}

float det_len3v(vec3 v){ return det_len3(v.x, v.y, v.z); }

/* mix(x, y, a) is SPECIFIED as x*(1-a) + y*a, so the definition is not
   in doubt - only the association and the fusion are. Written out with
   both pinned; deliberately not folded into an fma, because the spec's
   form is two roundings and a reader comparing this against the
   builtin should find the same shape. */
float det_mix(float a, float b, float t){
  precise float u = 1.0 - t;
  precise float p = a * u;
  precise float q = b * t;
  precise float r = p + q;
  return r;
}

/* smoothstep: the clamped ratio through the exact divide, then the
   Hermite polynomial with its own rounding pinned. clamp is an exact
   selection and needs nothing. */
float det_smoothstep(float e0, float e1, float x){
  precise float num = x - e0;
  precise float den = e1 - e0;
  precise float t = clamp(det_div(num, den), 0.0, 1.0);
  precise float t2 = t * t;
  precise float w = fma(-2.0, t, 3.0);
  precise float r = t2 * w;
  return r;
}

/* vec2 and vec3 division by a scalar, componentwise through det_div.
   The emitter generates these in cell arithmetic, where the divisor is
   a small integer cast to float and the result addresses a lattice -
   so a last-place difference moves a sample to a different cell, not
   to a slightly different place in the same one. */
vec2 det_div2(vec2 a, float b){
  return vec2(det_div(a.x, b), det_div(a.y, b));
}

/* dot() is the archetype of the problem: a sum of products, where both
   the summation order and whether any product folds into an fma are the
   compiler's to choose. Every product named, association stated. */
float det_dot3(vec3 a, vec3 b){
  precise float x = a.x * b.x;
  precise float y = a.y * b.y;
  precise float z = a.z * b.z;
  precise float s = x + y;
  precise float t = s + z;
  return t;
}

vec3 det_mix3(vec3 a, vec3 b, float t){
  return vec3(det_mix(a.x, b.x, t), det_mix(a.y, b.y, t),
              det_mix(a.z, b.z, t));
}

/* cross(): three differences of products, each of which a compiler is
   free to fuse one half of. */
vec3 det_cross(vec3 a, vec3 b){
  precise float x0 = a.y * b.z; precise float x1 = a.z * b.y;
  precise float y0 = a.z * b.x; precise float y1 = a.x * b.z;
  precise float z0 = a.x * b.y; precise float z1 = a.y * b.x;
  precise float x = x0 - x1;
  precise float y = y0 - y1;
  precise float z = z0 - z1;
  return vec3(x, y, z);
}

/* Rodrigues rotation, the whole expression pinned rather than its
   pieces. Written as three named vec3 terms so the sum has one
   association and no term can be fused into the next. */
vec3 det_rodrigues(vec3 c, vec3 k, float cs, float sn){
  precise float om = 1.0 - cs;
  vec3 t0 = c * cs;
  vec3 t1 = det_cross(k, c) * sn;
  precise float kd = det_dot3(k, c);
  precise float kdo = kd * om;
  vec3 t2 = k * kdo;
  return (t0 + t1) + t2;
}

/* ------------------------------------------------------------------
   The registry's shared-header helpers, pinned.

   Emitted plates CALL pal, cmul, cdiv, cinv and csqrt, whose bodies
   live in the registry header and are not pinned - pal reaches cos(),
   cdiv a raw division and a dot(). A text scan over emitted source
   cannot see into them, so a plate could pass every check above and
   still hold an unpinned transcendental at one remove. Measured
   2026-08-22: 38 of 54 positives call one.

   These are the same functions with association and rounding stated.
   They are NOT edits to the registry - the header keeps its
   definitions and the browser keeps using them; the emitter simply
   calls these instead when pinning. */

float det_pal1(float t, float a, float b, float c, float d){
  precise float ct = c * t;
  precise float s  = ct + d;
  precise float w  = TAU * s;
  precise float cw = det_cos(w);
  precise float bc = b * cw;
  precise float r  = a + bc;
  return r;
}

vec3 det_pal(float t, vec3 a, vec3 b, vec3 c, vec3 d){
  return vec3(det_pal1(t, a.x, b.x, c.x, d.x),
              det_pal1(t, a.y, b.y, c.y, d.y),
              det_pal1(t, a.z, b.z, c.z, d.z));
}

/* Complex multiply: two differences of products, each half of which a
   compiler may fuse. */
vec2 det_cmul(vec2 a, vec2 b){
  precise float xx = a.x * b.x;
  precise float yy = a.y * b.y;
  precise float xy = a.x * b.y;
  precise float yx = a.y * b.x;
  precise float re = xx - yy;
  precise float im = xy + yx;
  return vec2(re, im);
}

/* Complex divide: the modulus through named squares, the quotient
   through the exact divide. The 1e-30 guard is the header's and is
   kept exactly where the header puts it. */
vec2 det_cdiv(vec2 a, vec2 b){
  precise float bx = b.x * b.x;
  precise float by = b.y * b.y;
  precise float dd = bx + by;
  precise float d  = dd + 1.0e-30;
  precise float p1 = a.x * b.x;
  precise float p2 = a.y * b.y;
  precise float nr = p1 + p2;
  precise float p3 = a.y * b.x;
  precise float p4 = a.x * b.y;
  precise float ni = p3 - p4;
  return vec2(det_div(nr, d), det_div(ni, d));
}

vec2 det_cinv(vec2 a){
  precise float ax = a.x * a.x;
  precise float ay = a.y * a.y;
  precise float dd = ax + ay;
  precise float d  = dd + 1.0e-30;
  precise float ni = -a.y;
  return vec2(det_div(a.x, d), det_div(ni, d));
}

/* Complex square root. length() becomes det_len2, both sqrt() calls
   become det_sqrt, and the branch on the sign of the imaginary part is
   an exact comparison - note it tests `< 0.0`, which is FALSE for a
   negative zero, exactly as the header's version does. Keeping that
   quirk is deliberate: this is meant to be the header's function with
   its rounding pinned, not a corrected one. */
vec2 det_csqrt(vec2 z){
  precise float r  = det_len2(z.x, z.y);
  precise float sp = r + z.x;
  precise float sm = r - z.x;
  precise float hr = max(0.0, 0.5 * sp);
  precise float hi = max(0.0, 0.5 * sm);
  precise float re = det_sqrt(hr);
  precise float i0 = det_sqrt(hi);
  precise float im = (z.y < 0.0) ? -i0 : i0;
  return vec2(re, im);
}

/* fract, rebuilt from a truncating int conversion rather than from
   floor.

   The obvious form - floor, then subtract - is exact in principle:
   floor is exact and agrees bit for bit on every stack measured, and
   x - floor(x) is an exact subtraction, so no two conforming stacks
   can disagree on it. It still produced iris's answer on iris. The
   compiler recognises the idiom and folds it straight back into the
   instruction it was written to avoid; a bitcast round trip between
   the floor and the subtract does not stop it either. Both were
   measured, and both came back bit-identical to the bare builtin.

   That matters because the builtin is wrong there: Intel's fract is
   one ULP low for x in (-0.5, 0) - exactly the inputs whose result
   lands in [0.5, 1), where rounding is actually required - on 5.58%
   of the probe's sample set. So the fold was quietly reintroducing a
   real disagreement, which is also why routing the emitter's fract
   through det_fract had measured no change at all.

   Building floor out of int() leaves the optimiser nothing to
   recognise. Measured bit-identical on NVIDIA, radeonsi, iris and
   llvmpipe. (The darkroom's bake defines this too and its version
   wins there; the two are kept in step deliberately.) */
float det_fract(float x){
  /* |x| >= 2^23 is already an integer in float32: its fraction is
     exactly zero, and the int() below would overflow. */
  if (abs(x) >= 8388608.0) return 0.0;
  precise float t = float(int(x));
  precise float f = (x < 0.0 && t != x) ? t - 1.0 : t;
  precise float r = x - f;
  return r;
}

/* asin and the three hyperbolics.

   These were the engine's only expressive gap: `verify-pinned` refused
   four of fifty-four positives - domain on cosh, and rainbow,
   relativity and wavecat on asin - not because those plates were hard
   but because nothing here could pin the call. The darkroom's bake has
   carried proven forms for all four for some time, so the gap was one
   of routing rather than of mathematics, and these are those forms.

   Each is built ONLY from calls that are already pinned - det_sqrt,
   det_atan, det_exp2, det_recip, det_div - so none of them introduces
   a new claim about accuracy. They inherit whatever the kernels below
   already promise, and the constants oracle's bounds cover them by
   construction rather than by a second measurement.

   The identities, so a reader can check them rather than trust them:
     asin x  = atan2(x, sqrt(1 - x^2))
     sinh x  = (e^x - e^-x) / 2
     cosh x  = (e^x + e^-x) / 2
     tanh x  = (e^2x - 1) / (e^2x + 1)
   with e^x written as exp2(x * log2 e), because exp2 is the kernel
   that was actually verified. */
float det_asin(float x){
  precise float t = fma(-x, x, 1.0);
  precise float r = det_sqrt(t);
  return det_atan(x, r);
}
float det_sinh(float x){
  precise float e = det_exp2(x * @LOG2E);
  precise float r = det_recip(e);
  precise float d = e - r;
  return 0.5 * d;
}
float det_cosh(float x){
  precise float e = det_exp2(x * @LOG2E);
  precise float r = det_recip(e);
  precise float d = e + r;
  return 0.5 * d;
}
float det_tanh(float x){
  precise float e2 = det_exp2((x + x) * @LOG2E);
  precise float n = e2 - 1.0;
  precise float d = e2 + 1.0;
  return det_div(n, d);
}
